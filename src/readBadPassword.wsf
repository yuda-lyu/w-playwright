<?xml version="1.0" encoding="utf-8"?>
<job>
<script language="JScript"><![CDATA[
// Read-only: bad password attempts and lock state of a local account (WinNT ADSI).
// Usage: cscript //nologo readBadPassword.wsf <username>
// Output: one line {"bad":<number>,"locked":<true|false>} ; -1 means unreadable. No input value is echoed.
var bad = -1
var locked = -1
try {
    var name = WScript.Arguments.length > 0 ? WScript.Arguments(0) : ''
    if (name !== '') {
        var u = GetObject('WinNT://./' + name + ',user')
        try {
            var b = u.BadPasswordAttempts
            if (typeof b === 'number') {
                bad = b
            }
        }
        catch (e1) {}
        try {
            var l = u.IsAccountLocked
            if (l === true || l === false) {
                locked = l
            }
        }
        catch (e2) {}
    }
}
catch (e0) {}
WScript.Echo('{"bad":' + bad + ',"locked":' + (locked === -1 ? '-1' : (locked ? 'true' : 'false')) + '}')
]]></script>
</job>
